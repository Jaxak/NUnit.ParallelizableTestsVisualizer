<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- NuGet Package Properties -->
        <PackageId>NUnit.ParallelizableTestsVisualizer</PackageId>
        <Version>1.0.0</Version>
        <Authors>Simonov.MN (Jaxak)</Authors>
        <Description>Визуализатор параллельного выполнения тестов NUnit. Создает HTML отчеты с временной шкалой выполнения тестов по воркерам.</Description>
        <PackageTags>nunit;testing;parallel;visualization</PackageTags>
        <PackageProjectUrl>https://github.com/Jaxak/NUnit.ParallelizableTestsVisualizer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Jaxak/NUnit.ParallelizableTestsVisualizer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="4.4.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
